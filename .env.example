VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_PERSONAL_USER_ID=00000000-0000-4000-8000-000000000000

# Optional: protects /api/fitness-context for LLM/read-only data access. Use a long random secret.
FITNESS_API_TOKEN=change-me-long-random-token
# Optional server-only key for API route; falls back to VITE_SUPABASE_ANON_KEY if unset.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
